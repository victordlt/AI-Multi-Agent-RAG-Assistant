# Agente IA Profesional - Ejemplo de variables de entorno
# Copiar a .env and rellenar los valores.

# ----- Backend -----
APP_NAME= Agente IA Profesional
DEBUG=false
LOG_LEVEL=INFO

# API limits
MAX_UPLOAD_FILES=10
MAX_FILE_SIZE_MB=25
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Storage (paths relative to backend working dir or absolute)
UPLOAD_DIR=data/uploads
CHROMA_PERSIST_DIR=data/chroma
SQLITE_PATH=data/metadata.db

#LLM
LLM_MODEL=llama3

# RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVE=5
MIN_RELEVANCE_SCORE=0.0

# Use local sentence-transformers instead of API (no key needed)
USE_LOCAL_EMBEDDINGS= true #false
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ----- Frontend -----
# Vite proxy targets backend at localhost:8000 (see vite.config.ts). No env needed for local dev.
